{
  "name": "@ada-anvil/barrow",
  "description": "A framework for building event processing tools",
  "version": "0.1.0",
  "author": "Anvil Development Agency",
  "license": "Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/Cardano-Forge/anvil-barrow/issues"
  },
  "homepage": "https://github.com/Cardano-Forge/anvil-barrow",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cardano-Forge/anvil-barrow.git"
  },
  "keywords": [
    "javascript",
    "typescript",
    "typesafe",
    "ogmios",
    "blockchain",
    "cardano",
    "chain",
    "indexing",
    "indexer",
    "websocket",
    "web3"
  ],
  "sideEffects": false,
  "files": [
    "**"
  ],
  "main": "./index.js",
  "module": "./index.mjs",
  "types": "./index.d.mts",
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "lint": "biome check --write .",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "pre": "npm run lint && npm run check && npm run build && npm run test",
    "example": "node --import=tsx --env-file=.env src/examples/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@cardano-ogmios/client": "^6.13.0",
    "@opentelemetry/api": "^1.9.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "pino": "^9.9.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.205.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-node": "^0.205.0",
    "pino-opentelemetry-transport": "^1.0.1",
    "pino-pretty": "^11.3.0"
  },
  "peerDependencies": {
    "@cardano-ogmios/client": ">=6.0.0",
    "@opentelemetry/api": ">=1.0.0",
    "pino": ">=8.0.0"
  },
  "dependencies": {
    "trynot": "^0.0.2"
  }
}
